NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: comma-separated LAN hostnames allowed to reach `next dev`
# (for example 192.168.1.20). Leave empty for localhost-only development.
ALLOWED_DEV_ORIGINS=

# INSIDE v1 — admin dashboard key. Server-only, never NEXT_PUBLIC_.
ADMIN_SECRET_KEY=your-admin-secret-key

# Brevo transactional email (verification + feedback replies).
# Server-only, never NEXT_PUBLIC_. Reused by the feedback reply sender.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender-email
# Optional display name for the sender. Defaults to "us".
BREVO_SENDER_NAME=us
